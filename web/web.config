<?xml version="1.0" encoding="UTF-8"?>
<!--
  このファイルは最小構成。ハンドラや requestFiltering は IIS の既定で
  親レベルがロックされており、サイトの web.config に書くと
  500.19 (0x80070021) になる。管理者が設定をいじれない環境では
  このファイルを空にしておく。
  CGI (.py) の実行はサーバー側の既存の PythonCGI ハンドラに任せる。
  api.py へのパスは環境に合わせてサーバー側で設定済みであること。
-->
<configuration>
  <system.webServer>
  </system.webServer>
</configuration>
